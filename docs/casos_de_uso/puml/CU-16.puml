@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Visualizar dashboard de seguimiento
left to right direction
actor Gerente as G

rectangle "Visualizar dashboard" {
  usecase "Seleccionar proyecto o vista general" as UC1
  usecase "Consultar avance general del proyecto" as UC2
  usecase "Consultar costo consolidado" as UC3
  usecase "Consultar alertas activas" as UC4
  usecase "Consultar actividades atrasadas" as UC5
}

G --> UC1
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC4 ..> UC5 : <<extend>>
@enduml
