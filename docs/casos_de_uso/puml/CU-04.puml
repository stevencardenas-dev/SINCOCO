@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Registrar personal
left to right direction
actor Administrador as A

rectangle "Registrar personal" {
  usecase "Ingresar documento de identidad y tipo" as UC1
  usecase "Ingresar datos de contacto" as UC2
  usecase "Ingresar cargo y especialidad" as UC3
  usecase "Registrar fecha de contratación" as UC4
  usecase "Validar unicidad de documento/email" as UC5
  usecase "Registrar trabajador en estado ACTIVO" as UC6
}

A --> UC1
A --> UC2
A --> UC3
A --> UC4
UC1 ..> UC5 : <<include>>
UC5 ..> UC6 : <<include>>
@enduml
