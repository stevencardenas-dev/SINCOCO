@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Conservar historial (eliminación lógica)
left to right direction
actor Sistema as S

rectangle "Conservar historial" {
  usecase "Recibir solicitud de eliminación de registro" as UC1
  usecase "Marcar registro como INACTIVO" as UC2
  usecase "Registrar en bitácora de trazabilidad" as UC3
  usecase "Impedir borrado físico" as UC4
}

S --> UC1
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>
@enduml
