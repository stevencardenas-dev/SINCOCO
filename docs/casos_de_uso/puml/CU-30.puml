@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Solicitar herramientas
left to right direction

actor "Maestro de obra" as M
actor "Encargado de bodega" as B

rectangle "Solicitar herramientas" {
  usecase "Consultar herramientas disponibles en el catálogo" as UC1
  usecase "Registrar solicitud (herramienta, trabajador, proyecto)" as UC2
  usecase "Indicar fecha de solicitud y fecha requerida" as UC3
  usecase "Dejar solicitud en estado PENDIENTE" as UC4
  usecase "Aprobar solicitud" as UC5
  usecase "Rechazar solicitud" as UC6
  usecase "Registrar observación obligatoria del rechazo" as UC7
  usecase "Notificar al solicitante" as UC8
}

M --> UC1
M --> UC2
M --> UC3
B --> UC5
B --> UC6
UC2 ..> UC1 : <<include>>
UC2 ..> UC4 : <<include>>
UC6 ..> UC7 : <<include>>
UC6 ..> UC8 : <<include>>
UC4 ..> UC5 : <<extend>>\n(fecha requerida futura:\npermanece pendiente)

note bottom of UC4
  Estados: PENDIENTE, APROBADA,
  RECHAZADA, ENTREGADA, CANCELADA
  (schema: solicitudes_herramientas)
end note
@enduml
