@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Registrar porcentaje de avance
left to right direction
actor "Maestro de obra" as M

rectangle "Registrar porcentaje de avance" {
  usecase "Seleccionar actividad" as UC1
  usecase "Registrar porcentaje anterior y nuevo" as UC2
  usecase "Registrar fecha y observaciones" as UC3
  usecase "Recalcular avance de la etapa y del proyecto" as UC4
  usecase "Adjuntar evidencias" as UC5
  usecase "Marcar actividad como COMPLETADA (100%)" as UC6
}

M --> UC1
M --> UC2
M --> UC3
UC2 ..> UC4 : <<include>>
UC2 ..> UC5 : <<extend>>
UC4 ..> UC6 : <<extend>>
@enduml
