@startuml
skinparam backgroundColor white
skinparam dpi 200
skinparam shadowing false
skinparam nodesep 20
skinparam ranksep 60
skinparam defaultFontSize 17
skinparam usecaseFontSize 16
skinparam actorFontSize 17
skinparam packageFontSize 17
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam rectangle {
  BorderColor #A80036
  BackgroundColor #FDFDFD
}

left to right direction

actor Administrador as ADM
actor "Maestro\nde obra" as MAE
actor "Encargado\nde bodega" as BOD
actor Trabajador as TRA
actor Gerente as GER

rectangle "Administración y configuración" as R1 {
  usecase "Gestionar usuarios,\nroles y permisos" as U1
  usecase "Gestionar proyectos\ny plan de trabajo" as U2
  usecase "Gestionar personal\ny asignaciones" as U3
  usecase "Gestionar proveedores\ny servicios externos" as U7
}

rectangle "Operación en obra" as R2 {
  usecase "Registrar avance,\nevidencias e incidencias" as U4
  usecase "Controlar inventario\nde materiales" as U5
  usecase "Controlar inventario\nde herramientas" as U6
}

rectangle "Gerencia y control" as R3 {
  usecase "Consolidar costos\ne indicadores" as U8
  usecase "Generar alertas\ny reportes" as U9
  usecase "Auditar operaciones\ny trazabilidad" as U10
}

ADM --> U1
ADM --> U2
ADM --> U3
ADM --> U7
MAE --> U4
MAE --> U5
BOD --> U5
BOD --> U6
TRA --> U6
GER --> U8
GER --> U9
GER --> U10

ADM -[hidden]down- MAE
MAE -[hidden]down- BOD
BOD -[hidden]down- TRA
TRA -[hidden]down- GER
R1 -[hidden]down- R2
R2 -[hidden]down- R3

@enduml
