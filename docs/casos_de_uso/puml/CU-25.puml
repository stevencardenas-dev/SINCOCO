@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Generar y exportar reportes
left to right direction
actor Gerente as G

rectangle "Generar y exportar reportes" {
  usecase "Aplicar filtro por proyecto" as UC1
  usecase "Aplicar filtro por periodo" as UC2
  usecase "Aplicar filtro por material" as UC3
  usecase "Consolidar resultados del reporte" as UC4
  usecase "Exportar a PDF" as UC5
  usecase "Exportar a Excel" as UC6
}

G --> UC1
G --> UC2
G --> UC3
UC1 ..> UC4 : <<include>>
UC2 ..> UC4 : <<include>>
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<extend>>
UC4 ..> UC6 : <<extend>>
@enduml
