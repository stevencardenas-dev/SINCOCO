@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Entregar herramienta a trabajador
left to right direction
actor "Encargado de bodega" as B

rectangle "Entregar herramienta" {
  usecase "Seleccionar trabajador y herramienta disponible" as UC1
  usecase "Registrar proyecto de destino" as UC2
  usecase "Registrar estado de entrega (excelente/bueno/regular)" as UC3
  usecase "Registrar fecha estimada de devolución" as UC4
  usecase "Cambiar disponibilidad a PRESTADA" as UC5
}

B --> UC1
B --> UC2
B --> UC3
B --> UC4
UC1 ..> UC5 : <<include>>

note right of UC4
  Vencida la fecha estimada sin
  devolución → alimenta CU-24
end note
@enduml
