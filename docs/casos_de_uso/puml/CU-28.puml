@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Registrar detalle de servicio externo contratado
left to right direction
actor Administrador as A

rectangle "Registrar detalle de servicio contratado" {
  usecase "Seleccionar proveedor registrado" as UC1
  usecase "Seleccionar proyecto y actividad relacionada" as UC2
  usecase "Registrar responsable externo" as UC3
  usecase "Registrar fechas de inicio y fin" as UC4
  usecase "Registrar valor contratado" as UC5
  usecase "Actualizar estado del servicio" as UC6
}

A --> UC1
A --> UC2
A --> UC3
A --> UC4
A --> UC5
UC5 ..> UC6 : <<include>>

note right of UC6
  Dispara CU-15 (consolidar costos)
end note
@enduml
