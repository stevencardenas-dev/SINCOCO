@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Alertar actividades atrasadas y herramientas pendientes
left to right direction
actor Sistema as S
actor Gerente as G

rectangle "Alertar atrasos" {
  usecase "Detectar actividades con fecha fin programada vencida" as UC1
  usecase "Marcar actividad como ATRASADA" as UC2
  usecase "Detectar préstamos con fecha estimada vencida" as UC3
  usecase "Marcar préstamo como ATRASADO" as UC4
  usecase "Consolidar listado de alertas" as UC5
}

S --> UC1
S --> UC3
UC1 ..> UC2 : <<include>>
UC3 ..> UC4 : <<include>>
UC2 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 --> G
@enduml
