@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Registrar proyecto
left to right direction
actor Administrador as A

rectangle "Registrar proyecto" {
  usecase "Ingresar código único del proyecto" as UC1
  usecase "Ingresar ubicación y cliente" as UC2
  usecase "Ingresar fechas programadas de inicio y fin" as UC3
  usecase "Asignar responsable del proyecto" as UC4
  usecase "Ingresar presupuesto de referencia" as UC5
  usecase "Registrar proyecto en estado PLANIFICACION" as UC6
  usecase "Definir plan de trabajo" as UC7
}

A --> UC1
A --> UC2
A --> UC3
A --> UC4
A --> UC5
UC1 ..> UC6 : <<include>>
UC2 ..> UC6 : <<include>>
UC3 ..> UC6 : <<include>>
UC4 ..> UC6 : <<include>>
UC6 ..> UC7 : <<extend>>

note right of UC4
  responsable_id referencia a
  trabajadores (schema: proyectos)
end note
@enduml
