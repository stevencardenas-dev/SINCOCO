@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Trasladar materiales entre almacenes
left to right direction
actor "Encargado de bodega" as B

rectangle "Trasladar materiales entre almacenes" {
  usecase "Seleccionar almacén de origen y destino" as UC1
  usecase "Seleccionar material y cantidad" as UC2
  usecase "Validar existencia suficiente en origen" as UC3
  usecase "Descontar existencia del almacén origen" as UC4
  usecase "Sumar existencia al almacén destino" as UC5
  usecase "Registrar responsable y fecha del traslado" as UC6
}

B --> UC1
B --> UC2
B --> UC6
UC2 ..> UC3 : <<include>>
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>

note right of UC3
  Flujo alterno: cantidad mayor a
  existencia en origen → rechazado
end note
@enduml
