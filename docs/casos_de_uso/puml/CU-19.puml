@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Ingresar materiales al inventario
left to right direction
actor "Encargado de bodega" as B

rectangle "Ingresar materiales al inventario" {
  usecase "Seleccionar proveedor y almacén" as UC1
  usecase "Ingresar número de factura/remisión" as UC2
  usecase "Registrar detalle: material, cantidad y costo unitario" as UC3
  usecase "Calcular costo subtotal y total del ingreso" as UC4
  usecase "Actualizar existencia total por material" as UC5
  usecase "Registrar responsable del ingreso" as UC6
}

B --> UC1
B --> UC2
B --> UC3
B --> UC6
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>

note right of UC5
  Dispara CU-15 (consolidar costos)
  y puede resolver CU-23 (stock mínimo)
end note
@enduml
