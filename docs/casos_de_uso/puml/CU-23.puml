@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Alertar stock mínimo
left to right direction
actor Sistema as S
actor "Encargado de bodega" as B

rectangle "Alertar stock mínimo" {
  usecase "Comparar existencia total vs nivel mínimo" as UC1
  usecase "Generar alerta tipo STOCK_MINIMO" as UC2
  usecase "Mostrar alerta en dashboard" as UC3
  usecase "Marcar alerta como atendida" as UC4
}

S --> UC1
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC3 --> B
B --> UC4

note left of UC1
  Disparado por CU-20 (consumo)
  y CU-26 (salida efectiva)
end note
@enduml
