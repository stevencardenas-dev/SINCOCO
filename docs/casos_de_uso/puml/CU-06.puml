@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Consultar historial de asignaciones
left to right direction
actor Administrador as A

rectangle "Consultar historial de asignaciones" {
  usecase "Buscar trabajador" as UC1
  usecase "Listar proyectos y actividades asignadas" as UC2
  usecase "Mostrar fecha inicio, fin programada y fin real" as UC3
  usecase "Filtrar por estado (activo/finalizado/reasignado)" as UC4
}

A --> UC1
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
A --> UC4
@enduml
