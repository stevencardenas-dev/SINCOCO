@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Consolidar costos del proyecto
left to right direction
actor Sistema as S

rectangle "Consolidar costos del proyecto" {
  usecase "Sumar costo de entradas de inventario" as UC1
  usecase "Sumar costo de salidas asignadas al proyecto" as UC2
  usecase "Sumar valor de servicios externos contratados" as UC3
  usecase "Recalcular costo total del proyecto" as UC4
  usecase "Bloquear edición manual del costo" as UC5
}

S --> UC4
UC1 ..> UC4 : <<include>>
UC2 ..> UC4 : <<include>>
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>

note right of UC4
  Disparado por: CU-19, CU-26, CU-28
  Restricción: no editable manualmente
end note
@enduml
