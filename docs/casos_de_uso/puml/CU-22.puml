@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Adjuntar evidencias de avance
left to right direction
actor "Maestro de obra" as M

rectangle "Adjuntar evidencias" {
  usecase "Seleccionar registro de avance existente" as UC1
  usecase "Adjuntar uno o varios archivos (foto/documento)" as UC2
  usecase "Validar tipo y tamaño de archivo" as UC3
  usecase "Asociar archivo a fecha de avance" as UC4
}

M --> UC1
M --> UC2
UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>
@enduml
