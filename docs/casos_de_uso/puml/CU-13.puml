@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Registrar proveedores y servicios
left to right direction
actor Administrador as A

rectangle "Registrar proveedores y servicios" {
  usecase "Registrar documento y razón social del proveedor" as UC1
  usecase "Registrar datos de contacto" as UC2
  usecase "Validar documento único" as UC3
  usecase "Asociar proveedor a uno o más proyectos" as UC4
  usecase "Registrar detalle de servicio contratado" as UC5
}

A --> UC1
A --> UC2
A --> UC4
UC1 ..> UC3 : <<include>>
UC4 ..> UC5 : <<extend>>
@enduml
