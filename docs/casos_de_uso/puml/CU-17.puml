@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Consultar auditoría de operaciones
left to right direction
actor Administrador as A

rectangle "Consultar auditoría" {
  usecase "Filtrar por usuario, fecha o entidad afectada" as UC1
  usecase "Consultar acción realizada (crear/actualizar/eliminar)" as UC2
  usecase "Consultar valores anterior y nuevo" as UC3
  usecase "Consultar dirección IP del origen" as UC4
}

A --> UC1
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<extend>>
UC1 ..> UC4 : <<extend>>
@enduml
