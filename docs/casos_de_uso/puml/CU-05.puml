@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Asignar responsable a proyecto/actividad
left to right direction
actor Administrador as A

rectangle "Asignar responsable" {
  usecase "Seleccionar trabajador disponible" as UC1
  usecase "Seleccionar proyecto o actividad" as UC2
  usecase "Registrar fecha de inicio de la asignación" as UC3
  usecase "Definir rol en el proyecto" as UC4
  usecase "Definir fecha fin programada" as UC5
  usecase "Registrar asignación como ACTIVO" as UC6
  usecase "Reasignar trabajador (cierra asignación previa)" as UC7
}

A --> UC1
A --> UC2
A --> UC3
UC3 ..> UC6 : <<include>>
UC6 ..> UC4 : <<extend>>
UC6 ..> UC5 : <<extend>>
A --> UC7
UC7 ..> UC6 : <<include>>

note right of UC7
  estado pasa a REASIGNADO
  (schema: asignaciones_personal)
end note
@enduml
