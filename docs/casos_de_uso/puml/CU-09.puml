@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Devolver materiales sobrantes
left to right direction
actor "Encargado de bodega" as B
actor "Maestro de obra" as M

rectangle "Devolver materiales sobrantes" {
  usecase "Vincular a solicitud/salida previa del proyecto" as UC1
  usecase "Registrar cantidad devuelta por material" as UC2
  usecase "Registrar motivo de la devolución" as UC3
  usecase "Registrar almacén destino" as UC4
  usecase "Actualizar existencia disponible" as UC5
}

M --> UC1
B --> UC2
B --> UC3
B --> UC4
UC2 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>
@enduml
