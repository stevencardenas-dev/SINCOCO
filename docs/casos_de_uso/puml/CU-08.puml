@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Solicitar materiales
left to right direction
actor "Maestro de obra" as M

rectangle "Solicitar materiales" {
  usecase "Seleccionar proyecto y actividad" as UC1
  usecase "Seleccionar uno o varios materiales del catálogo" as UC2
  usecase "Indicar cantidad por material" as UC3
  usecase "Validar existencia disponible por material" as UC4
  usecase "Registrar solicitud pendiente de aprobación" as UC5
}

M --> UC1
M --> UC2
M --> UC3
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>

note right of UC5
  Flujo alterno: existencia insuficiente
  → la solicitud no descuenta inventario
  hasta que se despache (CU-26)
end note
@enduml
