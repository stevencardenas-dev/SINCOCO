@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Registrar salida efectiva de materiales
left to right direction
actor "Encargado de bodega" as B

rectangle "Registrar salida efectiva" {
  usecase "Vincular despacho a solicitud aprobada (CU-08)" as UC1
  usecase "Registrar detalle: material y cantidad despachada" as UC2
  usecase "Validar cantidad vs solicitado y existencias" as UC3
  usecase "Registrar trabajador que recibe" as UC4
  usecase "Descontar existencias del almacén origen" as UC5
}

B --> UC1
B --> UC2
B --> UC4
UC2 ..> UC3 : <<include>>
UC3 ..> UC5 : <<include>>

note bottom of UC5
  Flujo alterno: cantidad despachada
  mayor a solicitada o a existencias
  → rechazado
end note
@enduml
