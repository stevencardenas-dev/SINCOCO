@startuml
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}
skinparam actor {
  BorderColor #A80036
  BackgroundColor #FEFECE
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}
skinparam ArrowFontSize 11
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
title Diagrama de caso de uso: Registrar consumo real de materiales
left to right direction
actor "Maestro de obra" as M

rectangle "Registrar consumo real" {
  usecase "Seleccionar actividad" as UC1
  usecase "Seleccionar material y cantidad consumida" as UC2
  usecase "Vincular consumo a la salida despachada" as UC3
  usecase "Descontar existencia disponible" as UC4
}

M --> UC1
M --> UC2
UC2 ..> UC3 : <<include>>
UC3 ..> UC4 : <<include>>

note right of UC4
  Puede disparar CU-23
  (alerta de stock mínimo)
end note
@enduml
