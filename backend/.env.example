# Puerto del backend. Debe coincidir con el proxy de frontend/vite.config.js
PORT=3005

DB_HOST=localhost
DB_USER=sincoco
DB_PASSWORD=cambiar
DB_NAME=sincoco

# Cambiar por una cadena larga y aleatoria antes de cualquier despliegue (RNF04)
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria

# Correo de recuperación de contraseña (Gmail). SMTP_PASS es una "contraseña de
# aplicación" de Google (requiere verificación en 2 pasos), no la clave de la
# cuenta. Sin estas dos variables no se envían correos y el administrador
# entrega el código desde el módulo de Usuarios.
SMTP_USER=administracion.sincoco@gmail.com
SMTP_PASS=
